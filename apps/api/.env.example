PORT=3000
DATABASE_PATH=data/sattle.db
# true loads the demo fixtures into an empty database. Leave unset in production.
SEED=true
# Requests without a bearer token act as this user. Dev only — leave empty in production.
DEMO_USER_ID=u-yash
# Comma-separated; * when empty.
CORS_ORIGIN=http://localhost:8081

# `nwc` gets real invoices from payees' connected wallets or their own Lightning
# addresses. Anything else simulates.
PAYMENTS=sim

# Network Lightning-address invoices must be on: bc (mainnet), tbs (signet), tb, bcrt.
# LIGHTNING_NETWORK=bc

# SimulatedPayments, used unless PAYMENTS=nwc.
SIM_STEP_MS=400
SIM_SETTLE_MS=2500
SIM_RATE_FIAT_PER_BTC=9000000
SIM_ALWAYS_FAIL=false

# Comma-separated relays the group ledger is published to, signed and encrypted.
# Empty: entries are signed and kept, and go out once relays are set. Leave it
# empty for seeded dev data, so demo groups don't end up on public relays.
# Production: wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
LEDGER_RELAYS=

# Rates: live INR/BTC from CoinGecko, cached 30s. Used when it has never answered.
RATE_FALLBACK_INR_PER_BTC=9000000

# NWC test wallet for `npm run nwc:smoke`. From the shared password manager; never commit it.
NWC_URI=
