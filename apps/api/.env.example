PORT=3000
DATABASE_PATH=data/sattle.db
# Loads the demo fixtures into an empty database.
SEED=true
# Requests without a bearer token act as this user. Dev only — leave empty in production.
DEMO_USER_ID=u-yash
# Comma-separated; * when empty.
CORS_ORIGIN=http://localhost:8081

# SimulatedPayments — replaced by the NWC backend in step 3.
SIM_STEP_MS=400
SIM_SETTLE_MS=2500
SIM_RATE_FIAT_PER_BTC=9000000
SIM_ALWAYS_FAIL=false
