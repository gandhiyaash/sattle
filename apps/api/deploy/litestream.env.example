# /etc/sattle/litestream.env on the VM: what litestream.yml reads. It holds keys that can delete the
# backups, so it is root's alone; systemd reads it before starting sattle-litestream as ubuntu.
# Plain KEY=value lines: no quotes, no `export`. See the README, "Backups".

# Cloudflare R2. The account ID is on the R2 overview page in the dashboard.
BACKUP_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=sattle-backups

# An R2 API token with Object Read & Write on that one bucket.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# A healthchecks.io ping URL (https://hc-ping.com/<uuid>), for an email when backups stop.
# Empty: no pings.
BACKUP_HEARTBEAT_URL=
