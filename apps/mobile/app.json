{
  "expo": {
    "name": "sattle",
    "slug": "sattle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.sattle.app",
      "appleTeamId": "4G96L8W59F",
      "associatedDomains": ["applinks:sattle.tech", "applinks:sattle.axiosiiitl.dev"],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Sattle"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B57D0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chanakya.sattle",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "sattle.tech", "pathPrefix": "/join/" },
            { "scheme": "https", "host": "sattle.tech", "pathPrefix": "/g/" },
            { "scheme": "https", "host": "sattle.axiosiiitl.dev", "pathPrefix": "/join/" },
            { "scheme": "https", "host": "sattle.axiosiiitl.dev", "pathPrefix": "/g/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withIosSceneLifecycle",
      "./plugins/withIosReleaseSigning",
      ["expo-secure-store", { "faceIDPermission": false }]
    ]
  }
}
