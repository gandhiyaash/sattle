{
  "name": "sattle",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w @sattle/api\" \"EXPO_PUBLIC_USE_MOCK=false npm run web -w @sattle/mobile\"",
    "web": "npm run web -w @sattle/mobile",
    "api": "npm run dev -w @sattle/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~6.0.3"
  }
}
