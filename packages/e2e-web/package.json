    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sattle/core": "*",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
