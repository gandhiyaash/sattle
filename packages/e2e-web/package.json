{
  "name": "@sattle/e2e-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser tests for the web app against the real API, with Playwright.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
